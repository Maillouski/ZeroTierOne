<Window x:Class="ZeroTierTray.JoinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Join Network" Width="380" Height="170"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Network ID (16 hex characters):"/>
        <TextBox  Grid.Row="1" x:Name="NetworkIdBox" Margin="0,6,0,0" FontFamily="Consolas" FontSize="14"
                  MaxLength="16"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Join"   Width="80" IsDefault="True" Click="JoinClicked"/>
        </StackPanel>
    </Grid>
</Window>
