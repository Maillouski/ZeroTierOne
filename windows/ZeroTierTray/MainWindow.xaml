<Window x:Class="ZeroTierTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeroTier" Width="640" Height="420"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#202830" Padding="14,10">
            <StackPanel>
                <TextBlock Text="ZeroTier" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusLine" Foreground="#B8C4CC" FontSize="12" Margin="0,4,0,0"
                           Text="Loading..."/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#EFEFEF" Padding="10,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="JoinBtn"     Content="Join Network..." Padding="10,4" Margin="0,0,8,0" Click="JoinBtn_Click"/>
                <Button x:Name="LeaveBtn"    Content="Leave Selected"  Padding="10,4" Margin="0,0,8,0" Click="LeaveBtn_Click"/>
                <Button x:Name="RefreshBtn"  Content="Refresh"         Padding="10,4" Margin="0,0,8,0" Click="RefreshBtn_Click"/>
                <Button x:Name="CopyIdBtn"   Content="Copy Node ID"    Padding="10,4" Click="CopyIdBtn_Click"/>
            </StackPanel>
        </Border>

        <ListView x:Name="NetList" Margin="10" SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Network ID"  Width="150" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="Name"        Width="160" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Status"      Width="120" DisplayMemberBinding="{Binding Status}"/>
                    <GridViewColumn Header="Assigned IPs" Width="180" DisplayMemberBinding="{Binding Ips}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
